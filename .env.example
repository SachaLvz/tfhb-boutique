# Supabase — Project Settings → API
# URL du projet SANS /rest/v1 (le client JS l’ajoute)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# IA — import PDF (Anthropic Claude OU OpenAI)
# Une seule des deux suffit. Les clés sk-ant-… sont détectées automatiquement
# même si placées dans OPENAI_API_KEY.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
